<mxfile host="app.diagrams.net"><diagram id="c4-nivel-1" name="UCO Kudos - Diagrama de contexto (C4 nivel 1)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="UCO Kudos - Diagrama de contexto (C4 nivel 1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="900" height="30" as="geometry"/></mxCell><mxCell id="n_user" value="&lt;b style=&quot;font-size:14px&quot;&gt;Usuario de la comunidad&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Estudiante, docente, coordinadores, decano, rector y administrador&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#052e56;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="220" height="130" as="geometry"/></mxCell><mxCell id="n_kudos" value="&lt;b style=&quot;font-size:14px&quot;&gt;UCO Kudos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Plataforma institucional de reconocimientos: aplicación web y API&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="320" width="240" height="110" as="geometry"/></mxCell><mxCell id="n_entra" value="&lt;b style=&quot;font-size:14px&quot;&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Inicio de sesión y validaci